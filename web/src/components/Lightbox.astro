---
import { urlFor } from '../lib/sanity'

interface Props {
  images: any[]
}

const { images } = Astro.props
---

<!-- Grid Galeri -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
  {images?.map((item: any, index: number) => {
    // Deteksi apakah ini video (mendukung skema galeriItem beranda)
    const isVideo = item.videoUrl || item.tipeMedia === 'video'
    
    // Deteksi apakah datanya dibungkus di 'fileMedia' (skema beranda) atau gambar langsung (skema paket wisata)
    const imageSource = item.fileMedia ? item.fileMedia : item
    
    const mediaSrc = isVideo ? item.videoUrl : (imageSource ? urlFor(imageSource).width(1200).url() : '')
    const thumbSrc = imageSource ? urlFor(imageSource).width(500).height(500).url() : ''

    return (
      <div class="gallery-item aspect-square bg-gray-200 rounded-lg overflow-hidden cursor-pointer relative group" data-src={mediaSrc} data-type={isVideo ? 'video' : 'image'} data-index={index}>
        {thumbSrc && <img src={thumbSrc} alt="Galeri" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />}
        <div class="absolute inset-0 bg-brand-forest/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <i class={`fa-solid ${isVideo ? 'fa-play' : 'fa-magnifying-glass-plus'} text-white text-3xl`}></i>
        </div>
      </div>
    )
  })}
</div>

<!-- Modal Lightbox (z-index diperbesar agar tidak tertutup section lain) -->
<div id="lightbox" class="fixed inset-0 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 bg-black/95" style="z-index: 99999;">
  <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white text-4xl focus:outline-none z-50">
    <i class="fa-solid fa-xmark"></i>
  </button>
  <button id="lightbox-prev" class="absolute left-4 md:left-10 top-1/2 -translate-y-1/2 text-white/50 hover:text-white text-5xl focus:outline-none z-50 hidden md:block">
    <i class="fa-solid fa-chevron-left"></i>
  </button>
  <button id="lightbox-next" class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 text-white/50 hover:text-white text-5xl focus:outline-none z-50 hidden md:block">
    <i class="fa-solid fa-chevron-right"></i>
  </button>
  <div class="relative w-full max-w-5xl max-h-[85vh] px-4 flex justify-center items-center" id="lightbox-content">
    <!-- Konten media akan disuntikkan via JS -->
  </div>
</div>

<script>
  const galleryItems = document.querySelectorAll('.gallery-item')
  const lightbox = document.getElementById('lightbox')
  const lightboxContent = document.getElementById('lightbox-content')
  const lightboxClose = document.getElementById('lightbox-close')
  const lightboxPrev = document.getElementById('lightbox-prev')
  const lightboxNext = document.getElementById('lightbox-next')
  
  let currentGalleryIndex = 0

  function renderLightboxMedia(index: number) {
    if(!lightboxContent) return
    const src = galleryItems[index].getAttribute('data-src') || ''
    const type = galleryItems[index].getAttribute('data-type') || 'image'
    
    // Matikan media sebelumnya
    lightboxContent.innerHTML = ''
    
    // Render elemen yang tepat sesuai tipe (video atau image)
    if (type === 'video') {
      lightboxContent.innerHTML = `<video src="${src}" controls autoplay class="max-w-full max-h-[85vh] shadow-2xl rounded-sm transform scale-95 transition-transform duration-300 outline-none"></video>`
    } else {
      lightboxContent.innerHTML = `<img src="${src}" alt="Galeri Besar" class="max-w-full max-h-[85vh] object-contain shadow-2xl rounded-sm transform scale-95 transition-transform duration-300">`
    }
    
    setTimeout(() => {
      const mediaEl = lightboxContent.firstElementChild
      if (mediaEl) {
        mediaEl.classList.remove('scale-95')
        mediaEl.classList.add('scale-100')
      }
    }, 50)
  }

  function openLightbox(index: number) {
    currentGalleryIndex = index
    renderLightboxMedia(index)
    lightbox?.classList.remove('opacity-0', 'pointer-events-none')
    document.body.style.overflow = 'hidden' // Kunci scroll
  }

  function closeLightbox() {
    lightbox?.classList.add('opacity-0', 'pointer-events-none')
    if(lightboxContent) lightboxContent.innerHTML = '' // Hapus elemen agar video berhenti
    document.body.style.overflow = '' // Buka kunci scroll
  }

  galleryItems.forEach((item, index) => {
    item.addEventListener('click', () => openLightbox(index))
  })

  lightboxClose?.addEventListener('click', closeLightbox)
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox() })

  lightboxNext?.addEventListener('click', () => {
    currentGalleryIndex = (currentGalleryIndex + 1) % galleryItems.length
    renderLightboxMedia(currentGalleryIndex)
  })

  lightboxPrev?.addEventListener('click', () => {
    currentGalleryIndex = (currentGalleryIndex - 1 + galleryItems.length) % galleryItems.length
    renderLightboxMedia(currentGalleryIndex)
  })

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('opacity-0')) {
      if (e.key === 'Escape') closeLightbox()
      if (e.key === 'ArrowRight') {
        currentGalleryIndex = (currentGalleryIndex + 1) % galleryItems.length
        renderLightboxMedia(currentGalleryIndex)
      }
      if (e.key === 'ArrowLeft') {
        currentGalleryIndex = (currentGalleryIndex - 1 + galleryItems.length) % galleryItems.length
        renderLightboxMedia(currentGalleryIndex)
      }
    }
  })
</script>